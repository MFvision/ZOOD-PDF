# build outputs
target/
node_modules/
dist/
*.wasm
!tests/**/*.wasm
.DS_Store
# research scratch (regenerated by scripts)
docs/research/raw/*.tmp
tests/corpus/**/generated-large/
# secrets
.env
.env.*

# Local toolchain helpers for this machine (see .tools/env.sh); never committed.
.tools/

# Agent worktrees (Claude Code); each is its own checkout.
.claude/worktrees/

# The iOS app: the Xcode project is generated from apps/ios/project.yml by
# XcodeGen; the core is built into an XCFramework by scripts/ios/build-core.sh.
apps/ios/*.xcodeproj/
apps/ios/.build/
apps/ios/Vendor/*.xcframework/
DerivedData/
*.xcuserstate
