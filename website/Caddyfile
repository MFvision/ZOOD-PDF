# ZOOD PDF website on Caddy: HTTPS is automatic for the domain below.
# Override it with SITE_ADDRESS (for example ":8080" for a plain local run).
{$SITE_ADDRESS:pdf.zood.sa} {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Nothing outside this site is ever loaded. Inline style attributes carry the
		# per-element motion numbers (--i, --wi); no inline script is allowed.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Pictures and fonts are cached for a week; pages, scripts and styles are
	# checked again on every visit.
	@media path *.webp *.png *.svg *.woff2
	header @media Cache-Control "public, max-age=604800"
	@code path *.html *.js *.css / */
	header @code Cache-Control "no-cache"

	handle_errors {
		rewrite * /index.html
		file_server
	}
}
