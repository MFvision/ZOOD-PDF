{
  "name": "@warraq/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Warraq browser extension (Manifest V3, one build for Chrome, Edge and Brave): mounts @warraq/ui in viewer.html",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "check": "node scripts/check-manifest.mjs dist/manifest.json && node scripts/pack-chrome.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && node scripts/check-manifest.mjs"
  },
  "dependencies": {
    "@warraq/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
