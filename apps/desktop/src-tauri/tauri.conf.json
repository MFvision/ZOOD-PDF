{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZOOD PDF",
  "mainBinaryName": "warraq-desktop",
  "version": "0.1.0",
  "identifier": "app.warraq.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @warraq/web dev:tauri",
    "beforeBuildCommand": "pnpm --filter @warraq/web build:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "ZOOD PDF"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ZOOD PDF",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 19
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; worker-src 'self' blob:; frame-src blob:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com http://localhost:11434 http://127.0.0.1:11434 http://localhost:1234 http://127.0.0.1:1234 https://api.fontsource.org https://cdn.jsdelivr.net/fontsource/fonts/; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Open, account-free, Arabic-first PDF editor",
    "longDescription": "ZOOD PDF is an open, account-free, Arabic-first PDF editor. One Rust core, one RTL-first UI, thin hosts for Windows, macOS, browsers and later iOS.",
    "resources": [
      "resources/pdfium/LICENSE",
      "resources/pdfium/VERSION",
      "resources/pdfium/licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNjY2Mzg2OEIzRDBBODMKUldTRENqMkxobU5tb0tVcmo5Sm9mL1NmQVpUWTJRT2JvK2hMaHhHWGN3cEVHbi9JK0s4UTNMQlUK",
      "endpoints": [
        "https://github.com/MFvision/ZOOD-PDF/releases/download/updates-stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
