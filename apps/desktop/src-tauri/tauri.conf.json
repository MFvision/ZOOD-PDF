{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZOOD PDF",
  "mainBinaryName": "zood-pdf",
  "version": "0.1.0",
  "identifier": "sa.zood.pdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:ui",
    "beforeBuildCommand": "pnpm build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZOOD PDF",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:11434 http://localhost:1234 https://api.anthropic.com; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "ZOOD PDF (زود PDF) — an Arabic-first, account-free PDF editor",
    "longDescription": "ZOOD PDF (زود PDF) edits, organises, signs, converts and protects PDF files on your device. No account, no telemetry.",
    "copyright": "Copyright 2026 ZOOD PDF contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "office"
      }
    }
  }
}
