{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warraq",
  "version": "0.1.0",
  "identifier": "app.warraq.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @warraq/web dev",
    "beforeBuildCommand": "pnpm --filter @warraq/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Warraq",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Open, account-free, Arabic-first PDF editor",
    "longDescription": "Warraq is an open, account-free, Arabic-first PDF editor. One Rust core, one RTL-first UI, thin hosts for Windows, macOS, browsers and later iOS.",
    "resources": [
      "resources/pdfium/LICENSE",
      "resources/pdfium/VERSION",
      "resources/pdfium/licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
