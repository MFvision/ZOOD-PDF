<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime (needed for Apple's notarization) lets ZOOD PDF
     do. Without these, a Developer ID build is silently refused:
     - the microphone, for Ask ZOOD while its keys are held (src/ask/ear.rs);
     - Apple events to Finder, for the ring's shortcut on the selected files
       (src/ring.rs). macOS still asks the person the first time for each. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
