          }
        }
      }
    },
    "Use Latin letters, digits and symbols (up to 32): the PDF protection this device writes takes no others.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حروفًا لاتينية وأرقامًا ورموزًا (حتى 32): حماية PDF التي يكتبها هذا الجهاز لا تقبل غيرها."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "Vision reads the words on every page. The PDF gets them as a searchable layer when it is saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Vision الكلمات في كل صفحة، وتُضاف إلى ملف PDF طبقةً قابلة للبحث عند الحفظ."
          }
        }
      }
    },
