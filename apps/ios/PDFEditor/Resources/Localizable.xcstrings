{
  "sourceLanguage": "en",
  "strings": {
    "%@ is in My documents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ الآن في «مستنداتي»."
          }
        }
      }
    },
    "%@ needs the camera to scan paper. Nothing leaves this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج %@ إلى الكاميرا لمسح الورق. لا يخرج شيء من هذا الجهاز."
          }
        }
      }
    },
    "%@ will be deleted from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف %@ من هذا الجهاز."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ — p. %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — ص %2$lld"
          }
        }
      }
    },
    "%@ → %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من %1$@ إلى %2$@"
