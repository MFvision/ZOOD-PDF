            "value": "تراجع"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح القفل"
          }
        }
      }
    },
    "Unlock to open your documents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح القفل لفتح مستنداتك."
          }
        }
      }
    },
    "Unstar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة النجمة"
          }
        }
      }
    },
    "Use Latin letters, digits and symbols (up to 32): the PDF protection this device writes takes no others.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حروفًا لاتينية وأرقامًا ورموزًا (حتى 32): حماية PDF التي يكتبها هذا الجهاز لا تقبل غيرها."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "Vision reads the words on every page. The PDF gets them as a searchable layer when it is saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Vision الكلمات في كل صفحة، وتُضاف إلى ملف PDF طبقةً قابلة للبحث عند الحفظ."
          }
        }
      }
    },
    "Web page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة ويب"
          }
        }
      }
    },
    "Welcome to %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا بك في %@"
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكان"
          }
        }
      }
    },
    "Whiteboard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبورة"
          }
        }
      }
    },
    "Whiteboard: board to white, marker colours kept": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبورة: اللوح أبيض مع الحفاظ على ألوان الأقلام"
          }
        }
      }
    },
    "Whole": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة كاملة"
          }
        }
      }
    },
    "With the lock on, the app asks for %@ whenever it comes to the front. Nothing leaves this device either way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل القفل، يطلب التطبيق %@ كلما عاد إلى الواجهة. لا شيء يغادر هذا الجهاز في كلتا الحالتين."
          }
        }
      }
    },
    "With the lock on, the app asks for the passcode whenever it comes to the front. Nothing leaves this device either way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل القفل، يطلب التطبيق رمز الدخول كلما عاد إلى الواجهة. لا شيء يغادر هذا الجهاز في كلتا الحالتين."
          }
        }
      }
    },
    "Word": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Word"
          }
        }
      }
    },
    "Words inside every document": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات داخل كل مستند"
          }
        }
      }
    },
    "Words, separated by commas": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمات، مفصولة بفواصل"
          }
        }
      }
    },
    "Yellow": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصفر"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نعم"
          }
        }
      }
    },
    "Your signature": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيعك"
          }
        }
      }
    },
    "Your signature, kept on this device only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيعك محفوظ على هذا الجهاز وحده"
          }
        }
      }
    },
    "compressed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضغوط"
          }
        }
      }
    },
