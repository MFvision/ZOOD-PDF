{
  "sourceLanguage": "en",
  "strings": {
    "%@ is in My documents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ الآن في «مستنداتي»."
          }
        }
      }
    },
    "%@ will be deleted from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف %@ من هذا الجهاز."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
