    "It goes on if you leave the app; its progress is shown outside the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر إن غادرت التطبيق، ويظهر تقدّمها خارجه."
          }
        }
      }
    },
    "Keep the app open: iOS gives an app only a short time in the background, and the batch stops when it ends.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ التطبيق مفتوحًا: لا يمنح iOS التطبيق إلا وقتًا قصيرًا في الخلفية، وتتوقف الدفعة حين ينتهي."
          }
        }
      }
    },
    "iOS stopped the batch while the app was in the background. The files it had not finished are marked; run them again with the app open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف iOS الدفعة والتطبيق في الخلفية. الملفات التي لم تكتمل معلَّمة؛ شغّلها مجددًا والتطبيق مفتوح."
          }
        }
      }
    },
    "Done %lld · Failed %lld · Stopped %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنجز %1$lld · تعذّر %2$lld · أُوقف %3$lld"
          }
        }
      }
    },
    "Share the results": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك النتائج"
          }
        }
      }
    },
    "Progress": {
