    "Ends at %@, which browsers trust for web sites — not for who signs documents": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي عند %@، وهو ما تثق به المتصفحات للمواقع لا لمن يوقّع المستندات"
          }
        }
      }
    },
    "Ends at a root nobody here trusts: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي عند جذر لا يثق به أحد هنا: %@"
          }
        }
      }
    },
    "Form fields were filled in": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُلئت حقول النموذج"
