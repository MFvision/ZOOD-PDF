          "stringUnit": {
            "state": "translated",
            "value": "الشهادة"
          }
        }
      }
    },
    "Certificates you trust": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشهادات التي تثق بها"
          }
        }
      }
    },
    "Certification: filling forms and signing allowed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتماد: يُسمح بملء النماذج والتوقيع"
          }
        }
      }
    },
    "Certification: forms, signing and comments allowed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتماد: يُسمح بالنماذج والتوقيع والتعليقات"
          }
        }
      }
    },
    "Certification: no changes allowed": {
