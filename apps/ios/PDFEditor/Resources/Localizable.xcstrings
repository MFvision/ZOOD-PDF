            "value": "الزاوية العلوية اليسرى"
          }
        }
      }
    },
    "Top-right corner": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزاوية العلوية اليمنى"
          }
        }
      }
    },
    "Underline": {
      "localizations": {
        "ar": {
