    "Not done at step %lld, ": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنجَز عند الخطوة %lld، "
          }
        }
      }
    },
    "Not done: ": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنجَز: "
          }
        }
      }
    },
    "Stopped before it was finished": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف قبل أن يكتمل"
          }
        }
      }
    },
    "Stopped by the system before it was finished": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفه النظام قبل أن يكتمل"
          }
        }
      }
    },
    "No PDFs in My documents yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ملفات PDF في «مستنداتي» بعد."
          }
        }
      }
    },
    "Which pages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيّ الصفحات"
          }
        }
      }
    },
    "Read on this device in the languages chosen in the scanner's settings. The words become an invisible, searchable layer; the pages look as they did.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقرأ على هذا الجهاز باللغات المختارة في إعدادات الماسح. تصير الكلمات طبقة خفية يُبحث فيها، وتبقى الصفحات كما كانت."
          }
        }
      }
    },
    "Compression": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضغط"
          }
        }
      }
    },
    "Protected and signed files are left as they are and reported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُترك الملفات المحمية والموقَّعة كما هي ويُبلَّغ عنها."
          }
        }
      }
    },
    "Drawn as the Page marks sheet draws them; {page}, {pages}, {date} and {file} are filled in for each file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسم كما ترسمها «علامات الصفحات»، وتُملأ {page} و{pages} و{date} و{file} لكل ملف."
          }
        }
      }
    },
    "Document information (author, dates, …)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات المستند (المؤلف والتواريخ…)"
          }
        }
      }
    },
    "Comments and marks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعليقات والعلامات"
          }
        }
      }
    },
    "Form fields": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقول النماذج"
          }
        }
      }
    },
    "Other programs' private data": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات الخاصة ببرامج أخرى"
          }
        }
      }
    },
    "The file is written whole, without them and without its earlier versions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب الملف كاملًا من دونها ومن دون نسخه السابقة."
          }
        }
      }
    },
    "Allow printing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالطباعة"
          }
        }
      }
    },
    "Allow copying text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بنسخ النص"
          }
        }
      }
    },
    "Allow changes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالتعديل"
          }
        }
      }
    },
    "AES-256. The password is typed on the Batch screen when the sequence runs, and never saved with it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256. تُكتب كلمة السر في شاشة المعالجة الدفعية حين يُشغَّل التسلسل، ولا تُحفظ معه أبدًا."
          }
        }
      }
    },
    "Export makes something other than a PDF, so it is always the last step.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصدير يُخرج غير PDF، فهو دائمًا آخر خطوة."
          }
        }
      }
    },
    "For example 1-3, 5. Pages a file does not have are passed over.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل 1-3، 5. تُتجاوز الصفحات التي ليست في الملف."
          }
        }
      }
    },
    "Phone remote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم من الجوال"
          }
        }
      }
    },
    "Scan a new code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمزًا جديدًا"
          }
        }
      }
    },
    "Control ZOOD PDF on your computer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكّم في ZOOD PDF على جهازك"
          }
        }
      }
    },
    "On the computer, open ZOOD PDF and choose Phone remote in the toolbar. Then scan the QR code it shows. Your phone and computer need to be on the same Wi-Fi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الجهاز، افتح ZOOD PDF واختر «التحكم من الجوال» من شريط الأدوات، ثم امسح رمز QR الذي يظهر. يجب أن يكون الجوال والجهاز على شبكة Wi-Fi نفسها."
          }
        }
      }
    },
    "Scan the QR code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR"
          }
        }
      }
    },
    "This device can’t scan codes. Scan the code with the Camera app instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الجهاز مسح الرموز. امسح الرمز بتطبيق الكاميرا بدلًا من ذلك."
          }
        }
      }
    },
    "That code isn’t a ZOOD PDF remote code. Scan the code from Phone remote on your computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز ليس رمز التحكم من ZOOD PDF. امسح الرمز من «التحكم من الجوال» على جهازك."
          }
        }
      }
    },
