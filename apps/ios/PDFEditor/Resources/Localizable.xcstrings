    "Proposed values" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "القيم المقترحة" } }
      }
    },
    "Proposes a value for each empty text field from your profile or the document's own text. You review every value before anything is written." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يقترح قيمة لكل حقل نصي فارغ من ملفك الشخصي أو من نص المستند نفسه. وتراجع كل قيمة قبل أن يُكتب أي شيء." } }
      }
    },
    "Provider" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "المزوّد" } }
      }
    },
    "Quiz me" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختبرني" } }
      }
    },
    "Read aloud" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "القراءة بصوت عالٍ" } }
      }
    },
    "Read the beginning of the document only (pages %@): the on-device model reads a few pages at a time." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "قرأ بداية المستند فقط (الصفحات %@): يقرأ النموذج على الجهاز بضع صفحات في المرة." } }
      }
    },
    "Read the passages that match the question, on pages %@." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "قرأ المقاطع المطابقة للسؤال في الصفحات %@." } }
      }
    },
    "Read the whole document." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "قرأ المستند كاملًا." } }
      }
    },
    "Reading the form…" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ قراءة النموذج…" } }
      }
