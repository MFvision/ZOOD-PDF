      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق على كل الصفحات"
          }
        }
      }
    },
    "Arabic is not among the languages this device's text recognition supports.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العربية ليست من اللغات التي يدعمها التعرّف على النصوص في هذا الجهاز."
          }
        }
      }
    },
    "Arabic is not among the languages this device's text recognition supports; scans of Arabic pages get no searchable text here. The languages listed are the device's own answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العربية ليست من اللغات التي يدعمها التعرّف على النصوص في هذا الجهاز؛ لذا لا تحصل الصفحات العربية الممسوحة على نص قابل للبحث هنا. اللغات المدرجة هي إجابة الجهاز نفسه."
          }
        }
      }
    },
    "Arabic is shaped and stays searchable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشكَّل الحروف العربية ويبقى النص قابلًا للبحث."
          }
        }
      }
    },
