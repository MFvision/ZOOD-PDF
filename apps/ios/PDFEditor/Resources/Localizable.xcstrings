      }
    },
    "The model runs on this device. Nothing leaves it." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعمل النموذج على هذا الجهاز، ولا يغادره شيء." } }
      }
    },
    "The on-device model declined this request." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض النموذج على الجهاز هذا الطلب." } }
      }
    },
    "The on-device model is not ready yet — it may still be downloading. Try again later." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "النموذج على الجهاز غير جاهز بعد — قد يكون لا يزال يُنزَّل. حاول لاحقًا." } }
      }
    },
    "There is no text to read. Scan & OCR can add some." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا نص للقراءة. يمكن للمسح والتعرف الضوئي إضافته." } }
      }
    },
    "This device cannot run Apple Intelligence, so on-device AI is not available." : {
      "localizations" : {
