    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "Vision reads the words on every page. The PDF gets them as a searchable layer when it is saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Vision الكلمات في كل صفحة، وتُضاف إلى ملف PDF طبقةً قابلة للبحث عند الحفظ."
          }
        }
      }
    },
    "Voices are the system's, installed in the Settings app under Accessibility › Spoken Content › Voices; Premium and Enhanced voices sound best. Siri's voices are not offered to apps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصوات هي أصوات النظام، وتُثبَّت من تطبيق الإعدادات في: تسهيلات الاستخدام › المحتوى المنطوق › الأصوات؛ والأصوات المتميزة والمحسّنة أفضلها. أصوات Siri غير متاحة للتطبيقات."
          }
        }
      }
    },
    "Web page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة ويب"
          }
        }
