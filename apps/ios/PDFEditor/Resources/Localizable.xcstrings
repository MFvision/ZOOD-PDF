    },
    "Undo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح القفل"
          }
        }
      }
    },
    "Unlock to open your documents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح القفل لفتح مستنداتك."
          }
        }
      }
    },
    "Unstar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة النجمة"
          }
        }
      }
    },
    "Use Latin letters, digits and symbols (up to 32): the PDF protection this device writes takes no others.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حروفًا لاتينية وأرقامًا ورموزًا (حتى 32): حماية PDF التي يكتبها هذا الجهاز لا تقبل غيرها."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "Vision reads the words on every page. The PDF gets them as a searchable layer when it is saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Vision الكلمات في كل صفحة، وتُضاف إلى ملف PDF طبقةً قابلة للبحث عند الحفظ."
          }
        }
      }
    },
    "Web page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة ويب"
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكان"
          }
        }
      }
    },
    "Whiteboard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبورة"
          }
        }
      }
    },
    "Whiteboard: board to white, marker colours kept": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبورة: اللوح أبيض مع الحفاظ على ألوان الأقلام"
          }
        }
      }
    },
    "Whole": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة كاملة"
          }
        }
      }
    },
    "With the lock on, the app asks for %@ whenever it comes to the front. Nothing leaves this device either way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل القفل، يطلب التطبيق %@ كلما عاد إلى الواجهة. لا شيء يغادر هذا الجهاز في كلتا الحالتين."
          }
        }
      }
    },
    "With the lock on, the app asks for the passcode whenever it comes to the front. Nothing leaves this device either way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع تفعيل القفل، يطلب التطبيق رمز الدخول كلما عاد إلى الواجهة. لا شيء يغادر هذا الجهاز في كلتا الحالتين."
          }
        }
      }
    },
    "Word": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Word"
          }
        }
      }
    },
    "Words inside every document": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات داخل كل مستند"
          }
        }
      }
    },
    "Words, separated by commas": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمات، مفصولة بفواصل"
          }
        }
      }
    },
    "Yellow": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصفر"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نعم"
          }
        }
      }
    },
    "Your signature": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيعك"
          }
        }
      }
    },
    "compressed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضغوط"
          }
        }
      }
    },
    "curve %lld px": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانحناء %lld بكسل"
          }
        }
      }
    },
    "cut out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقصوصة"
          }
        }
      }
    },
    "levelled %@°": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُدِّل الميل %@°"
          }
        }
      }
    },
    "p. %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ص %lld"
          }
        }
      }
    },
    "pages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات"
          }
        }
      }
    },
    "stopped": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف"
          }
        }
      }
    },
    "العربية": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العربية"
          }
        }
      }
    },
    "Allow, with the password": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسموح به لمن يملك كلمة السر"
          }
        }
      }
    },
    "Any language works, Arabic included. Anyone opening the document will be asked for it, and there is no way to recover a forgotten password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلح أي لغة، والعربية منها. سيُطلب من كل من يفتح المستند إدخالها، ولا سبيل إلى استرجاع كلمة سر منسية."
          }
        }
      }
    },
    "Change the password": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير كلمة السر"
          }
        }
      }
    },
    "Changing the document": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعديل المستند"
          }
        }
      }
    },
    "Copying text and pictures": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ النص والصور"
          }
        }
      }
    },
    "It opens without a password: it carries only a permissions password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح بلا كلمة سر: لا يحمل سوى كلمة سر للصلاحيات."
          }
        }
      }
    },
    "Printing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطباعة"
          }
        }
      }
    },
    "Protected with %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محمي بـ %@."
          }
        }
      }
    },
    "The document records what it allows, and readers that honour it — this app among them — will. A reader that chooses to ignore it can. Reading aloud by a screen reader is always allowed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل المستند ما يسمح به، وتلتزم به البرامج التي تحترمه — وهذا التطبيق منها. أما برنامج اختار تجاهله فيستطيع ذلك. وتظل القراءة بقارئ الشاشة مسموحة دائمًا."
          }
        }
      }
    },
    "The password is too long. At most %lld bytes fit — about 63 Arabic letters, or 127 Latin ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة السر طويلة. تتسع %lld بايت على الأكثر — نحو ٦٣ حرفًا عربيًا، أو ١٢٧ حرفًا لاتينيًا."
          }
        }
      }
    },
    "This is an old, weak protection written by another program. Setting a password again replaces it with AES-256.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه حماية قديمة وضعيفة كتبها برنامج آخر. تعيين كلمة السر من جديد يستبدلها بتشفير AES-256."
          }
        }
      }
    },
    "%@ · valid until %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · صالحة حتى %2$@"
          }
        }
      }
    },
    "A certificate file (.p12 or .pfx) is kept in this device's Keychain, not in a file the Files app can reach. Its password is never kept: it is typed each time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ ملف الشهادة (‎.p12‎ أو ‎.pfx‎) في سلسلة مفاتيح هذا الجهاز، لا في ملف يصل إليه تطبيق الملفات. ولا تُحفظ كلمة سرها أبدًا: تُكتب في كل مرة."
          }
        }
      }
    },
    "A certificate in the path is missing, so who signed cannot be established.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهادة في المسار مفقودة، فلا تثبت هوية المُوقِّع."
          }
        }
      }
    },
    "A certificate on the path may not have issued the one below it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهادة في المسار لا يحق لها إصدار ما دونها."
          }
        }
      }
    },
    "A certificate was not valid at the time checked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهادة لم تكن صالحة في وقت الفحص"
          }
        }
      }
    },
    "A document timestamp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طابع زمني للمستند"
          }
        }
      }
    },
    "A locked form field changed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر حقل مقفل في النموذج"
          }
        }
      }
    },
    "A signature that is not shown still signs the file; it just draws nothing on the page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقيع غير الظاهر يوقّع الملف كغيره، غير أنه لا يرسم شيئًا على الصفحة."
          }
        }
      }
    },
    "A signature was altered": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُبث بتوقيع"
          }
        }
      }
    },
    "An approval signature": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيع موافقة"
          }
        }
      }
    },
    "Another signature was added": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيف توقيع آخر"
          }
        }
      }
    },
    "Approval signature": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيع موافقة"
          }
        }
      }
    },
    "Bottom, at the end of the line": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسفل الصفحة، عند نهاية السطر"
          }
        }
      }
    },
    "Bottom, at the start of the line": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسفل الصفحة، عند بداية السطر"
          }
        }
      }
    },
    "Broken at %@: it may not issue certificates": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منقطع عند %@: لا يحق له إصدار الشهادات"
          }
