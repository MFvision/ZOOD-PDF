      }
    },
    "Search finds words inside every document here, in Arabic or English.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد البحث الكلمات داخل كل مستند هنا، بالعربية أو الإنجليزية."
          }
        }
      }
    },
    "Search inside every document": {
