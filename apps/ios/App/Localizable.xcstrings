    "ai.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI isn’t available in this build on this device. Apple Intelligence needs iOS 26 on a supported device; the downloadable model needs a device build."
          }
        },
        "ar": {
