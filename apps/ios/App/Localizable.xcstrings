    "ai.model.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To answer without the internet, ZOOD PDF downloads a small open model once. It then works offline, with no account, key or fees."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإجابة دون اتصال بالإنترنت، يُنزّل «زود PDF» نموذجًا مفتوحًا صغيرًا مرة واحدة، ثم يعمل دون اتصال ودون حساب أو مفتاح أو رسوم."
          }
        }
      }
    },
    "ai.model.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen3 by Alibaba (Apache-2.0), run by llama.cpp. The file is checked against a fixed fingerprint and is not backed up to iCloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج Qwen3 من Alibaba (رخصة Apache-2.0) يعمل بواسطة llama.cpp. يُطابَق الملف مع بصمة ثابتة، ولا يُنسخ احتياطيًا إلى iCloud."
          }
        }
      }
    },
    "ai.model.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
