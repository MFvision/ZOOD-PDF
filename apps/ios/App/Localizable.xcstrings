    "ai.error.language": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model doesn’t support this language yet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم النموذج على الجهاز هذه اللغة بعد."
