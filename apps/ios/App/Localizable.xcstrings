      }
    },
    "ai.error.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model file could not be loaded. Delete it and download it again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل ملف النموذج. احذفه ثم نزّله من جديد."
          }
        }
      }
    },
    "ai.error.noModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the on-device model first (one time)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل النموذج على الجهاز أولًا (مرة واحدة فقط)."
          }
        }
      }
    },
    "ai.error.noText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document has no text to read (a scan without OCR?)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا المستند على نص يمكن قراءته (مسح ضوئي دون تعرّف على النص؟)."
          }
        }
      }
    },
    "ai.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model declined this request."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض النموذج هذا الطلب."
          }
        }
      }
    },
    "ai.error.runtimeMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloadable model runs only in device builds of the app. Apple Intelligence is used when available."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعمل النموذج القابل للتنزيل إلا في إصدارات التطبيق المخصّصة للأجهزة، ويُستخدم Apple Intelligence عند توفره."
          }
        }
      }
    },
    "ai.error.tooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is too long for the on-device model. Try a single page."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص أطول مما يستوعبه النموذج على الجهاز. جرّب صفحة واحدة."
          }
        }
      }
    },
    "ai.model.checksumFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file doesn’t match the expected fingerprint and was deleted."
