<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only by design: the database (favorites, packs, imported books) and preferences
     (including the chosen location) are excluded from cloud backup and device transfer.
     Built-in packs are reinstalled on first launch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
