{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zood.sa/near-mosque/pack-manifest.schema.json",
  "title": "Near Mosque data pack manifest",
  "description": "manifest.json at the root of every pack (cities, mosques, sources). Apps verify every listed file's SHA-256 before installing, and refuse schemaVersion values newer than they support.",
  "type": "object",
  "required": ["id", "kind", "schemaVersion", "version", "title", "source", "license", "files"],
  "properties": {
    "id": {"type": "string", "pattern": "^(cities|mosques|sources)\\.[a-z0-9-]+$"},
    "kind": {"enum": ["cities", "mosques", "sources"]},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "object", "required": ["en"], "additionalProperties": {"type": "string"}},
    "languages": {"type": "array", "items": {"type": "string"}},
    "recordCount": {"type": "integer", "minimum": 0},
    "categories": {"type": "object", "additionalProperties": {"type": "integer"}},
    "coverage": {
      "type": "object",
      "required": ["name", "bbox"],
      "properties": {
        "name": {"type": "string"},
        "bbox": {
          "type": "object",
          "required": ["minLat", "minLng", "maxLat", "maxLng"],
          "properties": {
            "minLat": {"type": "number", "minimum": -90, "maximum": 90},
            "maxLat": {"type": "number", "minimum": -90, "maximum": 90},
            "minLng": {"type": "number", "minimum": -180, "maximum": 180},
            "maxLng": {"type": "number", "minimum": -180, "maximum": 180}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"},
        "snapshot": {"type": "string"},
        "builtAt": {"type": "string"}
      }
    },
    "license": {
      "type": "object",
      "required": ["id", "name", "url", "attribution"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "url": {"type": "string"},
        "attribution": {"type": "string"},
        "attributionUrl": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/][^\\\\]*$", "not": {"pattern": "\\.\\."}},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
