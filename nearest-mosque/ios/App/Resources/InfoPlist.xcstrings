            "state": "translated",
            "value": "Near Mosque"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرب مسجد"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی مسجد"
          }
        },
        "tr": {
          "stringUnit": {
