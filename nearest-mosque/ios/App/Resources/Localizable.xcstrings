    "choose_city_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are calculated on your phone. Pick a city or use your location. No internet needed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب المواقيت على هاتفك. اختر مدينة أو استخدم موقعك، دون الحاجة إلى الإنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات آپ کے فون پر ہی شمار ہوتے ہیں۔ شہر منتخب کریں یا اپنا مقام استعمال کریں، انٹرنیٹ کی ضرورت نہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler telefonunuzda hesaplanır. Bir şehir seçin veya konumunuzu kullanın. İnternet gerekmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal salat dihitung di ponsel Anda. Pilih kota atau gunakan lokasi Anda. Tanpa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires sont calculés sur votre téléphone. Choisissez une ville ou utilisez votre position. Sans internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios se calculan en tu teléfono. Elige una ciudad o usa tu ubicación. Sin internet."
          }
        }
      }
    },
