    "polar_rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sun doesn’t rise or set"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند عدم شروق الشمس أو غروبها"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب سورج طلوع یا غروب نہ ہو"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş doğmadığında veya batmadığında"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat matahari tidak terbit atau terbenam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le soleil ne se lève ou ne se couche pas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el sol no sale o no se pone"
          }
        }
      }
    },
    "polar_unavailable_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this latitude the sun doesn’t rise or set today, so ordinary times don’t exist. You can choose a high-latitude rule."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا العرض لا تشرق الشمس أو لا تغرب اليوم، فلا توجد مواقيت معتادة. يمكنك اختيار قاعدة العروض العليا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عرض بلد پر آج سورج طلوع یا غروب نہیں ہوتا، اس لیے عام اوقات موجود نہیں۔ آپ بلند عرض بلد کا اصول منتخب کر سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu enlemde güneş bugün doğmuyor ya da batmıyor; olağan vakitler yok. Bir yüksek enlem kuralı seçebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di lintang ini matahari tidak terbit atau terbenam hari ini, jadi jadwal biasa tidak ada. Anda dapat memilih aturan lintang tinggi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette latitude, le soleil ne se lève pas ou ne se couche pas aujourd’hui. Vous pouvez choisir une règle pour hautes latitudes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta latitud el sol no sale o no se pone hoy, así que no hay horarios ordinarios. Puedes elegir una regla de latitudes altas."
          }
        }
      }
    },
    "polar_unavailable_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times can’t be calculated for this date"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حساب المواقيت لهذا اليوم"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دن کے اوقات شمار نہیں ہو سکتے"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarih için vakitler hesaplanamıyor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal tidak dapat dihitung untuk tanggal ini"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de calculer les horaires ce jour-là"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden calcular los horarios para esta fecha"
          }
        }
      }
    },
