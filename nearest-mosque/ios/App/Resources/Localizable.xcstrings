    "reminder_horizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are set for the next %1$lld days. Open the app now and then to keep them going."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات مجدولة للأيام %1$lld القادمة. افتح التطبيق من حين لآخر لتستمر."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانیاں اگلے %1$lld دنوں کے لیے مقرر ہیں۔ انہیں جاری رکھنے کے لیے کبھی کبھار ایپ کھولیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar önümüzdeki %1$lld gün için kuruldu. Sürmeleri için uygulamayı ara sıra açın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat diatur untuk %1$lld hari ke depan. Buka aplikasi sesekali agar tetap berjalan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels programmés pour les %1$lld prochains jours. Ouvrez l’app de temps en temps pour les prolonger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios programados para los próximos %1$lld días. Abre la app de vez en cuando para mantenerlos."
          }
        }
      }
    },
