    "answer_from_passages_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These passages best match your question. Read them in context before drawing a conclusion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المقاطع هي الأقرب إلى سؤالك. اقرأها في سياقها قبل أن تستنتج."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اقتباسات آپ کے سوال سے سب سے زیادہ ملتے ہیں۔ نتیجہ نکالنے سے پہلے انہیں سیاق میں پڑھیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölümler sorunuza en çok uyanlar. Sonuca varmadan önce bağlamıyla okuyun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutipan ini paling sesuai dengan pertanyaan Anda. Bacalah dalam konteksnya sebelum menyimpulkan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces passages correspondent le mieux à votre question. Lisez-les dans leur contexte avant de conclure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos pasajes son los que mejor encajan. Léelos en contexto antes de sacar conclusiones."
          }
        }
      }
    },
    "answer_generated_on_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written on your phone from these sources"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتبت على هاتفك من هذه المصادر"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انہی ماخذ سے آپ کے فون پر لکھا گیا"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynaklardan telefonunuzda yazıldı"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditulis di ponsel Anda dari sumber ini"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigé sur votre téléphone à partir de ces sources"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactado en tu teléfono a partir de estas fuentes"
          }
        }
      }
    },
    "answer_insufficient_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers only come from books on your phone. Try other words, a common question, or add books in Downloads."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابات تأتي فقط من الكتب على هاتفك. جرّب كلمات أخرى أو سؤالًا شائعًا، أو أضف كتبًا من التنزيلات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات صرف آپ کے فون کی کتابوں سے آتے ہیں۔ دوسرے الفاظ یا عام سوال آزمائیں، یا ڈاؤن لوڈز سے کتابیں شامل کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar yalnızca telefonunuzdaki kitaplardan gelir. Başka kelimeler veya sık sorulan bir soru deneyin ya da İndirilenler’den kitap ekleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban hanya berasal dari buku di ponsel Anda. Coba kata lain, pertanyaan umum, atau tambahkan buku di Unduhan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses viennent uniquement des livres de votre téléphone. Essayez d’autres mots, une question courante, ou ajoutez des livres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas solo salen de los libros de tu teléfono. Prueba otras palabras, una pregunta común o añade libros."
          }
        }
      }
    },
    "answer_insufficient_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn’t find this in your books"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أجد هذا في كتبك"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کی کتابوں میں نہیں ملا"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kitaplarınızda bulamadım"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak menemukannya di buku Anda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai pas trouvé cela dans vos livres"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontré esto en tus libros"
          }
        }
      }
    },
    "answer_language_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your books are in Arabic and English. Quotes stay in their original language."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتبك باللغتين العربية والإنجليزية، وتبقى الاقتباسات بلغتها الأصلية."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کتابیں عربی اور انگریزی میں ہیں؛ اقتباسات اپنی اصل زبان میں رہتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplarınız Arapça ve İngilizce. Alıntılar orijinal dillerinde kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku Anda berbahasa Arab dan Inggris. Kutipan tetap dalam bahasa aslinya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos livres sont en arabe et en anglais. Les citations restent dans leur langue d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus libros están en árabe e inglés. Las citas se mantienen en su idioma original."
          }
        }
      }
    },
    "answer_not_fatwa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers quote books; they are not a fatwa. For a personal ruling, ask a qualified scholar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابات اقتباسات من الكتب وليست فتوى. للحكم في حالتك اسأل عالمًا مؤهلًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات کتابوں کے حوالے ہیں، فتویٰ نہیں۔ ذاتی مسئلے کے لیے مستند عالم سے پوچھیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar kitaplardan alıntıdır, fetva değildir. Kişisel bir hüküm için yetkin bir âlime danışın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban adalah kutipan buku, bukan fatwa. Untuk hukum pribadi, tanyakan kepada ulama yang berkompeten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent des livres ; ce n’est pas une fatwa. Pour votre cas, consultez un savant qualifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan libros; no son una fetua. Para tu caso, consulta a un erudito cualificado."
          }
        }
      }
    },
