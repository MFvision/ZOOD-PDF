    "ai_language_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device writing isn’t available in this language. Showing quotes instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة على الجهاز غير متاحة بهذه اللغة، لذا تُعرض الاقتباسات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس زبان میں فون پر لکھائی دستیاب نہیں، اس لیے اقتباسات دکھائے جا رہے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilde cihaz içi yazım yok. Bunun yerine alıntılar gösteriliyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penulisan di perangkat tidak tersedia dalam bahasa ini. Menampilkan kutipan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rédaction sur l’appareil n’existe pas dans cette langue. Citations affichées à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redacción en el dispositivo no está disponible en este idioma. Se muestran citas."
          }
        }
      }
    },
    "ai_pack_not_installed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI isn’t available on this phone yet. You still get answers that quote your books."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء على الجهاز غير متاح على هذا الهاتف بعد، وستحصل مع ذلك على إجابات تقتبس من كتبك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون پر AI ابھی دستیاب نہیں۔ پھر بھی آپ کو کتابوں کے حوالوں والے جوابات ملیں گے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz içi yapay zekâ bu telefonda henüz yok. Yine de kitaplarınızdan alıntı yapan cevaplar alırsınız."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI di perangkat belum tersedia di ponsel ini. Anda tetap mendapat jawaban yang mengutip buku Anda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA sur l’appareil n’est pas encore disponible ici. Vous recevez quand même des réponses citant vos livres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA en el dispositivo aún no está disponible aquí. Igualmente recibirás respuestas que citan tus libros."
          }
        }
      }
    },
