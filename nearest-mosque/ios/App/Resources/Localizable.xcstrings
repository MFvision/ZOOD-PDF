    "online_offline_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Showing downloaded mosques only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. تُعرض المساجد المحمّلة فقط."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آف لائن ہیں۔ صرف ڈاؤن لوڈ کردہ مساجد دکھائی جا رہی ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Yalnızca indirilen camiler gösteriliyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Hanya masjid yang diunduh yang ditampilkan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Seules les mosquées téléchargées sont affichées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Solo se muestran las mezquitas descargadas."
          }
        }
      }
    },
    "online_search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search online for mosques"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن المساجد عبر الإنترنت"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد آن لائن تلاش کریں"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camileri çevrimiçi ara"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari masjid secara online"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
