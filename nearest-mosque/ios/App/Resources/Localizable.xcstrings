    "confirm_time_zone_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This point is far from the cities we know, so we can’t be sure of its time zone. Prayer times will use %1$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النقطة بعيدة عن المدن المعروفة لدينا، لذا لا نستطيع الجزم بمنطقتها الزمنية. ستُستخدم %1$@ للمواقيت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مقام ہمارے معلوم شہروں سے دور ہے، اس لیے ٹائم زون یقینی نہیں۔ اوقات کے لیے %1$@ استعمال ہوگا۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nokta bildiğimiz şehirlerden uzak, saat dilimi kesin değil. Vakitler için %1$@ kullanılacak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik ini jauh dari kota yang kami kenal, jadi zona waktunya belum pasti. Jadwal akan memakai %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point est loin des villes connues : son fuseau est incertain. Les horaires utiliseront %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto está lejos de las ciudades conocidas y su zona horaria es incierta. Se usará %1$@."
          }
        }
      }
    },
