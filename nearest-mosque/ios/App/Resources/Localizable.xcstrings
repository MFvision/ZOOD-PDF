    "no_records_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded data for %1$@ has no mosques within %2$@ of this point. The data may be incomplete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي بيانات %1$@ المحمّلة على مساجد ضمن %2$@ من هذه النقطة. قد تكون البيانات ناقصة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کے ڈاؤن لوڈ شدہ ڈیٹا میں اس مقام سے %2$@ کے اندر کوئی مسجد نہیں۔ ڈیٹا نامکمل ہو سکتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ için indirilen veride bu noktaya %2$@ içinde cami yok. Veri eksik olabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data %1$@ yang diunduh tidak memuat masjid dalam %2$@ dari titik ini. Data mungkin belum lengkap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de %1$@ ne contiennent aucune mosquée à moins de %2$@. Elles peuvent être incomplètes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de %1$@ no tienen mezquitas a menos de %2$@ de este punto. Pueden estar incompletos."
          }
        }
      }
    },
