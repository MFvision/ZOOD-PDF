          }
        }
      }
    },
    "online_search_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds live results to your downloaded data. Your approximate location (about 1 km) is sent to the map service. The live map also loads map images for the area you view."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف نتائج مباشرة إلى بياناتك المحمّلة. يُرسل موقعك التقريبي (نحو 1 كم) إلى خدمة الخرائط. كما تحمّل الخريطة الحية صور المنطقة التي تشاهدها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ڈاؤن لوڈ کردہ ڈیٹا میں براہ راست نتائج شامل کرتا ہے۔ آپ کا تقریبی مقام (تقریباً 1 کلومیٹر) نقشہ سروس کو بھیجا جاتا ہے۔ لائیو نقشہ دیکھے جانے والے علاقے کی تصاویر بھی لوڈ کرتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen verilere canlı sonuçlar ekler. Yaklaşık konumunuz (yaklaşık 1 km) harita hizmetine gönderilir. Canlı harita, baktığınız bölgenin görüntülerini de yükler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan hasil langsung ke data unduhan Anda. Lokasi perkiraan Anda (sekitar 1 km) dikirim ke layanan peta. Peta langsung juga memuat gambar area yang Anda lihat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des résultats en direct à vos données téléchargées. Votre position approximative (environ 1 km) est envoyée au service de cartes. La carte en direct charge aussi les images de la zone affichée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade resultados en vivo a tus datos descargados. Tu ubicación aproximada (unos 1 km) se envía al servicio de mapas. El mapa en vivo también carga imágenes de la zona que ves."
          }
        }
      }
    },
    "online_searching": {
      "extractionState": "manual",
      "localizations": {
