    "hijri_calendar_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijri dates use the Umm al-Qura calendar. Local moon sighting can differ by a day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري وفق تقويم أم القرى، وقد تختلف رؤية الهلال المحلية بيوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہجری تاریخ ام القریٰ کیلنڈر کے مطابق ہے؛ مقامی رؤیت میں ایک دن کا فرق ہو سکتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarihler Ümmü’l-Kurâ takvimine göredir; yerel hilal gözlemi bir gün farklı olabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Hijriah memakai kalender Umm al-Qura; rukyat lokal bisa berbeda sehari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates hégiriennes selon le calendrier Umm al-Qura ; l’observation locale peut différer d’un jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas hégiras usan el calendario Umm al-Qura; el avistamiento local puede variar un día."
          }
        }
      }
    },
