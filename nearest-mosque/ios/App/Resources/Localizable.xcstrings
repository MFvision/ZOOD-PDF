    "external_maps_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directions open in your maps app. Turn-by-turn needs that app and usually internet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الاتجاهات في تطبيق الخرائط، والملاحة خطوة بخطوة تحتاج ذلك التطبيق وغالبًا الإنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "راستہ آپ کی میپس ایپ میں کھلے گا۔ قدم بہ قدم رہنمائی کے لیے وہ ایپ اور عموماً انٹرنیٹ درکار ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yol tarifi harita uygulamanızda açılır. Adım adım yönlendirme o uygulamayı ve genellikle internet gerektirir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk arah terbuka di aplikasi peta Anda. Navigasi belokan perlu aplikasi itu dan biasanya internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’itinéraire s’ouvre dans votre app de cartes, qui demande souvent internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las indicaciones se abren en tu app de mapas, que suele necesitar internet."
          }
        }
      }
    },
