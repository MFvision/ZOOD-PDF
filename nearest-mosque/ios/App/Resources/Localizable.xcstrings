    "onb_mosque_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See mosques around you on a live map or a compass, with distance and one-tap directions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد المساجد من حولك على خريطة حية أو بوصلة، مع المسافة والاتجاهات بلمسة واحدة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے آس پاس کی مساجد لائیو نقشے یا قطب نما پر دیکھیں، فاصلے اور ایک ٹیپ میں راستے کے ساتھ۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki camileri canlı haritada veya pusulada, mesafe ve tek dokunuşla yol tarifiyle görün."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat masjid di sekitar Anda di peta langsung atau kompas, lengkap dengan jarak dan petunjuk arah sekali ketuk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez les mosquées autour de vous sur une carte en direct ou une boussole, avec la distance et l’itinéraire en un geste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira las mezquitas a tu alrededor en un mapa en vivo o una brújula, con la distancia y la ruta con un toque."
          }
        }
      }
    },
