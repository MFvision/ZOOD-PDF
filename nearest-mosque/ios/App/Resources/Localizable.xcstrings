    "qibla_calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass accuracy is low. Move your phone in a figure 8, away from metal and magnets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقة البوصلة منخفضة. حرّك الهاتف على شكل الرقم 8 بعيدًا عن المعادن والمغناطيس."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب نما کی درستی کم ہے۔ فون کو دھات اور مقناطیس سے دور 8 کی شکل میں گھمائیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusula hassasiyeti düşük. Telefonu metal ve mıknatıslardan uzakta 8 çizerek hareket ettirin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akurasi kompas rendah. Gerakkan ponsel membentuk angka 8, jauh dari logam dan magnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précision faible. Décrivez un 8 avec le téléphone, loin du métal et des aimants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisión baja. Mueve el teléfono en forma de 8, lejos de metales e imanes."
          }
        }
      }
    },
