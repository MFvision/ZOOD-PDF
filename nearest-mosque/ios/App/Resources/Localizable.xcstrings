    "onb_prayer_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are calculated on your phone for where you are. The sky changes with each prayer and a countdown shows what comes next."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب المواقيت على هاتفك لموقعك. تتغير السماء مع كل صلاة، ويعرض العدّ التنازلي الصلاة القادمة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات آپ کے مقام کے لیے آپ کے فون پر حساب ہوتے ہیں۔ ہر نماز کے ساتھ آسمان بدلتا ہے اور الٹی گنتی اگلی نماز دکھاتی ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler bulunduğunuz yer için telefonunuzda hesaplanır. Gökyüzü her namazla değişir, geri sayım sıradakini gösterir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu dihitung di ponsel untuk lokasi Anda. Langit berubah di setiap waktu salat dan hitung mundur menunjukkan salat berikutnya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires sont calculés sur votre téléphone pour l’endroit où vous êtes. Le ciel change à chaque prière et un compte à rebours annonce la suivante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios se calculan en tu teléfono para donde estás. El cielo cambia con cada oración y una cuenta atrás muestra la siguiente."
          }
        }
      }
    },
    "onb_prayer_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times that follow the sky"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت تتبع السماء"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آسمان کے ساتھ چلتے اوقات"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzünü izleyen vakitler"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu salat mengikuti langit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des horaires qui suivent le ciel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horarios que siguen al cielo"
          }
        }
      }
    },
    "onb_qibla_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your phone flat and turn slowly. When the gold dot meets the Kaaba at the top, you’re facing the Qibla and it glows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك هاتفك بشكل مستوٍ واستدر ببطء. عندما تلتقي النقطة الذهبية بالكعبة في الأعلى فأنت باتجاه القبلة ويتوهج القرص."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کو سیدھا رکھیں اور آہستہ گھومیں۔ جب سنہری نقطہ اوپر کعبہ سے ملے تو آپ قبلہ رخ ہیں اور ڈسک چمکتی ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düz tutun ve yavaşça dönün. Altın nokta üstteki Kâbe ile buluştuğunda kıbleye dönüksünüz ve disk parlar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel mendatar dan berputar perlahan. Saat titik emas bertemu Ka’bah di atas, Anda menghadap kiblat dan cakramnya bersinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le téléphone à plat et tournez lentement. Quand le point doré rejoint la Kaaba en haut, vous faites face à la qibla et le disque s’illumine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén el teléfono en horizontal y gira despacio. Cuando el punto dorado llega a la Kaaba arriba, estás orientado a la alquibla y el disco brilla."
          }
        }
      }
    },
    "onb_qibla_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the Qibla"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجه إلى القبلة"
          }
