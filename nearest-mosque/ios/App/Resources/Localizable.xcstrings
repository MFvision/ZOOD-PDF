    "region_not_downloaded_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosque lists work offline for downloaded areas. On this phone: %1$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوائم المساجد تعمل دون إنترنت للمناطق المحمّلة. على هذا الهاتف: %1$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد کی فہرست ڈاؤن لوڈ شدہ علاقوں میں آف لائن کام کرتی ہے۔ اس فون پر: %1$@۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cami listeleri indirilen bölgelerde çevrim dışı çalışır. Bu telefonda: %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masjid berfungsi offline untuk wilayah yang diunduh. Di ponsel ini: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes fonctionnent hors ligne pour les zones téléchargées. Sur ce téléphone : %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas funcionan sin conexión en zonas descargadas. En este teléfono: %1$@."
