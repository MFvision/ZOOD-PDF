    "onb_setup_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your language and where to calculate prayer times. You can change both in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغتك والمكان الذي تُحسب له المواقيت. يمكنك تغييرهما من الإعدادات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی زبان اور وہ مقام منتخب کریں جس کے لیے اوقات حساب ہوں۔ دونوں ترتیبات میں بدل سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilinizi ve vakitlerin hesaplanacağı yeri seçin. İkisini de Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa dan lokasi untuk menghitung waktu salat. Keduanya bisa diubah di Pengaturan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre langue et le lieu de calcul des horaires. Vous pourrez les modifier dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu idioma y dónde calcular los horarios. Puedes cambiar ambos en Ajustes."
          }
        }
      }
    },
