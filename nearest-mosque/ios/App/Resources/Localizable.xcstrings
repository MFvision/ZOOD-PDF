    "onb_ask_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers quote the Qur’an with the verse reference, so you can always check the source."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقتبس الإجابات من القرآن مع رقم الآية، لتتحقق من المصدر دائمًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات قرآن سے آیت کے حوالے کے ساتھ اقتباس دیتے ہیں تاکہ آپ ہمیشہ ماخذ دیکھ سکیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar Kur’an’dan ayet numarasıyla alıntı yapar; kaynağı her zaman kontrol edebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban mengutip Al-Qur’an beserta nomor ayatnya, sehingga Anda selalu bisa memeriksa sumbernya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent le Coran avec la référence du verset, pour que vous puissiez toujours vérifier la source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan el Corán con la referencia de la aleya, para que siempre puedas comprobar la fuente."
          }
        }
      }
    },
