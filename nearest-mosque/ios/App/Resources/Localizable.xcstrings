    "onb_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, the Qibla, nearby mosques and answers from trusted sources, all on your phone and working offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت الصلاة والقبلة وأقرب المساجد وإجابات من مصادر موثوقة، كلها على هاتفك وتعمل دون إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات، قبلہ، قریبی مساجد اور معتبر ذرائع سے جوابات، سب آپ کے فون پر اور بغیر انٹرنیٹ کے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitleri, kıble, yakındaki camiler ve güvenilir kaynaklardan cevaplar; hepsi telefonunuzda ve çevrimdışı çalışır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu salat, kiblat, masjid terdekat, dan jawaban dari sumber tepercaya, semuanya di ponsel Anda dan bisa tanpa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaires de prière, qibla, mosquées proches et réponses tirées de sources fiables, sur votre téléphone et hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horarios de oración, la alquibla, mezquitas cercanas y respuestas de fuentes fiables, en tu teléfono y sin conexión."
          }
        }
      }
    },
    "onb_welcome_title": {
      "extractionState": "manual",
      "localizations": {
