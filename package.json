{
  "name": "warraq-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:core": "wasm-pack build packages/core/warraq-core --target web --release --out-dir ../../ui/src/core-wasm --out-name warraq_core",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "dev:web": "pnpm --filter @warraq/web dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.9.3",
      "source-map-js": ">=1.2.2"
    }
  }
}
